---
interface Props {
  content: string;
  href: string;
  ariaLabel?: string;
  width?: string;
  height?: string;
  background?: string;
  color?: string;
}

const {
  content,
  href = "/",
  width = "clamp-[w,8rem,12rem]",
  height = "h-10",
  background = "bg-lime-green",
  color = "text-white",
  ariaLabel = "",
} = Astro.props;
---

<a
  href={href}
  class=`${width} ${height} ${color} ${background} `
  aria-label={ariaLabel}
>
  {content}
</a>

<style>
  a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 600;
    cursor: pointer;
    transform: scale(1);
    transition: transform 0.3s ease;
  }

  a:hover {
    transform: scale(1.1);
  }

  a:active {
    transform: scale(1.05);
  }
</style>
