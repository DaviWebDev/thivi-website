---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import ButtonLink from "./ButtonLink.astro";

interface CardData {
  image: {
    src: ImageMetadata;
    alt: string;
  };
  title: string;
  description: string;
  btn: {
    value: string;
    href: string;
  };
}

interface Props {
  cardData: CardData;
  className: string;
}

const { cardData, className } = Astro.props;
const { image, title, description, btn } = cardData;
---

<article class={className}>
  <div class="aspect-4/3 overflow-hidden">
    <Image src={image.src} alt={image.alt} layout="constrained" class="size-full object-cover" quality={70} />
  </div>
  <div class="min-h-50 flex flex-col gap-3">
    <h2 class="text-dark-olive-green clamp-[text,1.1rem,1.4rem] font-semibold">{title}</h2>
    <p class="line-clamp-4">{description}</p>
  </div>
  <div class="">
    <ButtonLink content={btn.value} href={btn.href} />
  </div>
</article>

<style>
  article {
    width: 100%;
    max-width: 20rem;
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1.25rem;
  }
</style>
