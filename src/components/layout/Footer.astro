---
import { Icon } from "astro-icon/components";
import { footerInfo, footerLinks } from "../../data/footer.ts";
---

<footer class="bg-dark-green text-white/75 w-full flex justify-center">
  <div class="footer-inner max-w-300 flex flex-col gap-10 flex-1 px-5 py-10 lg:py-20 xl:px-0">
    <div class="footer-inner__content">
      <div class="flex flex-col gap-5">
        <a href="/" aria-label="Thivi, home" class="logo-footer">
          <Icon name="logo/logo-footer" />
        </a>
        <p class="max-w-140">
          We have been recruiting from the Culinary Arts for the past 4 years and I must say it has been a real pleasure to have the
          students on board.
        </p>
      </div>
      <div class="flex gap-15 md:gap-0 md:justify-around">
        {footerLinks.map(({ title, links }) => (
          <div class="flex flex-col gap-4">
            <span class="font-bold text-white">{title}</span>
            <nav aria-label={`${title} menu`}>
              <ul class="flex flex-col gap-2">
                {links.map(({ label, href }) => (
                  <li>
                    <a
                      href={href}
                      class="underline underline-offset-5 transition-colors duration-300 ease-in-out hover:text-white"
                      aria-label={label}
                    >
                      {label}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          </div>
        ))}
      </div>

      <address class="not-italic">
        <dl class="flex flex-col gap-4">
          {footerInfo.map((item) => (
            <div class="flex items-center gap-3">
              <dt class="font-bold text-white">{item.title}:</dt>
              <dd>
                {item.type === "social" ? (
                  <ul class="flex">
                    {item.socialMedia.map((social) => (
                      <li>
                        <a href={social.href} aria-label={social.name}>
                          <Icon name={social.icon} class="text-4xl transition-colors duration-300 ease-in-out hover:text-white" />
                        </a>
                      </li>
                    ))}
                  </ul>
                ) : item.type === "link" ? (
                  <a href={item.href}>{item.value}</a>
                ) : (
                  item.value
                )}
              </dd>
            </div>
          ))}
        </dl>
      </address>
    </div>
    <small>© Thivi, Edu. 2019. We love our users!</small>
  </div>
</footer>

<style>
  .footer-inner__content {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    align-items: start;
    gap: clamp(3rem, 5vw, 7rem);
    padding-bottom: 2rem;
  }

  .footer-inner__content::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    background-color: rgba(255, 255, 255, 0.25);
    width: 100%;
    height: 2px;
    border-radius: 2rem;
  }

  .logo-footer {
    font-size: 2.5rem;
  }

  @media (width >= 36.25rem) {
    .footer-inner__content {
      grid-template-columns: repeat(2, 1fr);
    }

    .logo-footer {
      font-size: 2rem;
      align-self: flex-start;
    }
  }

  @media (width >= 64rem) {
    .footer-inner__content {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (width >= 90rem) {
    .footer-inner__content::after {
      left: 50%;
      width: calc((100vw - 2rem));
      max-width: 100rem;
      transform: translateX(-50%);
    }
  }
</style>
