---
import { getCollection } from "astro:content";
/*Astro Components*/
import { Icon } from "astro-icon/components";
import { Picture, getImage, Image } from "astro:assets";
/*Components*/
import Layout from "../layout/Layout.astro";
import ButtonLink from "../components/ui/ButtonLink.astro";
import Card from "../components/ui/Card.astro";
import Carousel from "../components/ui/Carousel.astro";
/*Images*/
import heroBackground from "../assets/images/hero-home-img.png";
import AboutImage from "../assets/images/about-img.png";
/*scripts*/
import { heroCards } from "../data/home.ts";
import { getCourseVisual, orderPrograms } from "../data/courses.ts";
/*Data*/
import siteMetaData from "../constants/siteMetaData.json";

const programs = orderPrograms(await getCollection("programs"));
const bgHero = await getImage({
  src: heroBackground,
  widths: [640, 960, 1280],
  quality: 80,
  format: "webp",
});
---

<Layout seo={siteMetaData.pages.home} class="flex flex-col gap-20 mb-20">
  <link
    rel="preload"
    as="image"
    imagesrcset={bgHero.srcSet.attribute}
    imagesizes="100vw"
    type="image/webp"
    fetchpriority="high"
    slot="preload"
  />

  <section class="hero">
    <div class="hero__bg">
      <Picture
        src={heroBackground}
        formats={["webp"]}
        quality={80}
        widths={[640, 960, 1280]}
        sizes="100vw"
        alt=""
        loading="eager"
        decoding="async"
        fetchpriority="high"
        class="size-full object-cover"
      />
    </div>
    <div class="hero__content flex justify-center items-center">
      <div class="text-center text-shadow-lg text-white max-w-300 flex-1 px-2 xs:text-start xs:px-5">
        <h1 class="clamp-[text,1.4rem,2.5rem] font-bold mb-5 xs:max-w-130">
          Build your future in hospitality.
        </h1>
        <p class="clamp-[text,0.95rem,1.25rem] xs:max-w-120">
          Explore practical learning in guest service, food and beverage, team
          leadership, and digital promotion.
        </p>
      </div>
    </div>
    <div class="hero__cards flex justify-center">
      <div class="hero__cards-content max-w-300 flex-1 m-2">
        {heroCards.map(({ image, title, txt }) => (
          <div class="bg-white text-center max-w-70 min-w-70 min-h-87.5 flex flex-col items-center gap-5 px-5 py-15 shadow-xl mb-10">
            <Icon name={image} class="text-6xl" />
            <h2 class="text-dark-olive-green text-xl">{title}</h2>
            <p>{txt}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
  <section class="flex justify-center items-center [content-visibility:auto] [contain-intrinsic-size:auto_600px]">
    <div class="max-w-300 min-h-[min(40svh,40rem)] flex flex-col-reverse items-center gap-10 px-2 md:flex-row">
      <div class="text-center max-w-120 flex flex-col items-center gap-5 sm:text-start sm:items-start">
        <h2 class="clamp-[text,1.5rem,2rem] font-semibold relative before:absolute before:bg-lime-green before:h-full before:w-2 before:-inset-s-8 sm:ms-8">
          About Thivi Edu.
        </h2>
        <p>
          Thivi Edu brings culinary craft and hospitality know-how together.
          Explore programs focused on the skills behind memorable guest
          experiences, from thoughtful service to well-planned operations.
        </p>
        <ButtonLink content="Learn More" href="/about" />
      </div>
      <div class="relative w-full max-w-120 min-w-60 aspect-4/3 after:absolute after:bg-lime-green/37 after:inset-0 after:w-full after:h-full">
        <Image
          src={AboutImage}
          alt="Group of people cooking"
          layout="constrained"
          quality={70}
          class="size-full object-cover"
        />
      </div>
    </div>
  </section>
  <section class="relative isolate flex justify-center px-5 [content-visibility:auto] [contain-intrinsic-size:auto_600px]">
    <div class="absolute inset-0 -z-1 overflow-clip after:absolute after:inset-0 after:bg-lime-green/37">
      <Image
        src={heroBackground}
        alt=""
        class="size-full object-cover"
        quality={70}
      />
    </div>
    <div class="text-center text-white min-h-[min(50svh,40rem)] flex flex-col gap-5 justify-center items-center">
      <h2 class="font-bold clamp-[text,1.5rem,1.8rem]">
        Skills for every guest experience
      </h2>
      <p class="max-w-160 clamp-[text,1rem,1.2rem]">
        From preparing a service to communicating a brand, explore how practical
        skills connect across the hospitality industry.
      </p>
      <ButtonLink content="Explore Programs" href="/programs" />
    </div>
  </section>
  <section class="w-full min-w-0 flex justify-center [content-visibility:auto] [contain-intrinsic-size:auto_600px]">
    <div class="max-w-300 min-w-0 flex flex-col gap-10">
      <div class="max-w-175 flex flex-col gap-10 text-center self-center px-5">
        <h2 class="relative clamp-[text,1.2rem,1.8rem] font-semibold before:absolute before:bg-lime-green before:h-1 before:w-10 before:-bottom-2 before:left-[50%] before:transform-[translateX(-50%)]">
          Our Courses
        </h2>
        <p>
          Choose a pathway in hospitality operations, team leadership, or
          digital communication for the hospitality sector.
        </p>
      </div>
      <div class="w-full min-w-0">
        <Carousel label="Our Courses">
          {programs.map((program, index) => {
            const visual = getCourseVisual(program.id);

            return (
              <Card
                className="carousel__card w-full"
                slug={`/programs/${program.id}`}
                title={program.data.title}
                excerpt={program.data.description}
                image={visual.image}
                imageAlt={visual.imageAlt}
                quality={index === 0 ? 80 : 70}
                priority={index === 0}
                btnContent="Read More"
              />
            );
          })}
        </Carousel>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero {
    --overlap: 0px;
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .hero__content {
    min-height: min(50svh, 40rem);
  }

  .hero__bg {
    position: absolute;
    inset: 0 0 var(--overlap) 0;
    z-index: -1;
    overflow: clip;
  }

  .hero__bg::after {
    content: "";
    position: absolute;
    inset: -2px;
    background-image:
      linear-gradient(
        to top,
        rgba(255, 255, 255, 0.2) 0%,
        rgba(255, 255, 255, 0) 100%
      ),
      linear-gradient(
        to top,
        rgb(20, 82, 29, 1) 0%,
        rgb(20, 82, 29, 0.7) 70%,
        rgb(20, 82, 29, 0.1) 100%
      );
  }

  .hero__cards-content {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    grid-template-rows: auto;
    grid-auto-rows: 0;
    justify-items: center;
    column-gap: 3rem;
    row-gap: 0;
    overflow: hidden;
  }

  @media (width >= 64rem) {
    .hero {
      --overlap: 11rem;
    }

    .hero__bg::before {
      background-image:
        linear-gradient(
          to right,
          rgba(255, 255, 255, 0.2) 0%,
          rgba(255, 255, 255, 0) 100%
        ),
        linear-gradient(
          to right,
          rgb(20, 82, 29, 1) 0%,
          rgb(20, 82, 29, 0.7) 70%,
          rgb(20, 82, 29, 0.4) 100%
        );
    }
  }
</style>
