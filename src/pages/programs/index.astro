---
import { getCollection } from "astro:content";
/*Astro Components*/
import { Image } from "astro:assets";
/*Components*/
import Layout from "../../layout/Layout.astro";
/*data*/
import siteMetaData from "../../constants/siteMetaData.json";
import { getCourseVisual, orderPrograms } from "../../data/courses.ts";
import ButtonLink from "../../components/ui/ButtonLink.astro";

const programs = orderPrograms(await getCollection("programs"));
---

<Layout seo={siteMetaData.pages.programs} class="flex justify-center">
  <section class="flex flex-col gap-10 max-w-300 my-15 px-5">
    <h1 class="relative clamp-[text,1.2rem,2.2rem] font-semibold before:absolute before:bottom-0 before:clamp-[w,3.5rem,6.5rem] before:h-1 before:bg-lime-green">
      Programs at Thivi
    </h1>
    <ul class="flex flex-col gap-10 lg:gap-0">
      {programs.map((program, index) => {
        const visual = getCourseVisual(program.id);

        return (
          <li>
            <article
              class:list={[
                "flex flex-col items-center gap-10 md:flex-row lg:gap-0",
                index % 2 !== 0 && "md:flex-row-reverse",
              ]}
            >
              <div class="relative after:absolute after:inset-0 after:bg-lime-green/52 md:flex-1">
                <Image
                  src={visual.image}
                  alt={visual.imageAlt}
                  priority={index === 0}
                  quality={index === 0 ? 80 : 70}
                />
              </div>
              <div class="md:flex-1">
                <div class="flex flex-col gap-5 lg:px-15">
                  <h2 class="text-2xl font-semibold text-dark-olive-green">
                    {program.data.title}
                  </h2>
                  <p>{program.data.description}</p>
                  <ButtonLink
                    content="Learn More"
                    href={`/programs/${program.id}`}
                    ariaLabel={program.data.title}
                  />
                </div>
              </div>
            </article>
          </li>
        );
      })}
    </ul>
  </section>
</Layout>
