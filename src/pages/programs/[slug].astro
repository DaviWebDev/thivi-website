---
/*Types*/
import type { GetStaticPaths } from "astro";
import type { CollectionEntry } from "astro:content";
/*Astro Components*/
import { getCollection, render } from "astro:content";
import { Picture } from "astro:assets";
import { Icon } from "astro-icon/components";
/*Components*/
import Layout from "../../layout/Layout.astro";

type Program = CollectionEntry<"programs">;

interface Props {
  program: Program;
}

export const getStaticPaths = (async () => {
  const programs = await getCollection("programs");

  return programs.map((program: Program) => ({
    params: { slug: program.id },
    props: { program },
  }));
}) satisfies GetStaticPaths;

const { program } = Astro.props;
const { Content } = await render(program);
---

<Layout
  seo={{
    title: `${program.data.title} | Thivi`,
    description: program.data.description,
  }}
  class="flex items-center flex-col"
>
  <div class="flex flex-col relative w-full">
    <div class="full-bleed">
      <Picture
        src={program.data.bg}
        formats={["webp"]}
        quality={80}
        widths={[640, 960, 1280]}
        sizes="100vw"
        alt=""
        priority
        position="center"
        class="size-full object-cover"
      />
    </div>
    <div class="absolute inset-0 flex items-end">
      <div class="mx-auto w-full max-w-300 px-5 pb-10">
        <h1 class="relative clamp-[text,1.4rem,2.8rem] font-semibold text-white before:absolute before:bottom-0 before:clamp-[w,4rem,6.5rem] before:h-1 before:bg-lime-green">
          {program.data.title}
        </h1>
      </div>
    </div>
  </div>
  <article class="program-content max-w-300 pt-10 pb-20 px-5">
    <Content />
    <a
      href="/news"
      class="btn-back flex justify-center items-center gap-2 w-50 h-12 mt-20 text-white bg-lime-green"
    >
      <Icon name="arrow-left" />
      Back to news
    </a>
  </article>
</Layout>

<style>
  .full-bleed {
    position: relative;
    isolation: isolate;
    z-index: -1;
    width: 100%;
    overflow: clip;
  }

  .full-bleed::after {
    content: "";
    position: absolute;
    background-image: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.8) 0%,
      rgba(0, 0, 0, 0.6) 50%,
      rgba(0, 0, 0, 0) 100%
    );
    inset: -2px;
  }

  .full-bleed :global(img) {
    height: clamp(12rem, 20vw + 3rem, 20rem);
  }

  .program-content > :global(h2),
  .program-content > :global(h3) {
    font-weight: 600;
  }

  .program-content > :global(h2) {
    margin-bottom: 1rem;
    font-size: clamp(1.4rem, 2vw + 1rem, 1.6rem);
    color: var(--color-dark-olive-green);
  }

  .program-content > :global(h3) {
    margin-bottom: 0.8rem;
    font-size: 1.2rem;
  }

  .program-content > :global(p) {
    margin-bottom: 1.5rem;
  }

  .program-content > :global(ul) {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .program-content > :global(p),
  .program-content :global(li) {
    color: #949191;
  }

  .program-content :global(li) {
    position: relative;
    padding-inline-start: 1.5rem;
  }

  .program-content :global(li)::before {
    content: "";
    position: absolute;
    top: 50%;
    left: 0;
    width: 15px;
    height: 15px;
    border-radius: 50%;
    background-color: #94919133;
    transform: translateY(-50%);
  }

  .btn-back {
    transform: scale(1);
    transition: transform 0.3s ease;
  }

  .btn-back:hover {
    transform: scale(1.1);
  }

  .btn-back:active {
    transform: scale(0.95);
  }
</style>
