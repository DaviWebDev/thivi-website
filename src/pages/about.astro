---
/*Astro Components*/
import { Image } from "astro:assets";
/*Components*/
import Layout from "../layout/Layout.astro";
/*Images*/
import aboutImg from "../assets/images/about-img.png";
/*Data*/
import siteMetaData from "../constants/siteMetaData.json";
---

<Layout seo={siteMetaData.pages.about} class="flex justify-center">
  <section class="about max-w-300 px-5 my-15 xl:px-0">
    <h1 class="about__title relative clamp-[text,1.4rem,2.25rem] font-semibold before:absolute before:bottom-0 before:clamp-[w,4rem,7rem] before:h-1 before:bg-lime-green">
      About Thivi Edu.
    </h1>
    <div class="about__image relative max-w-fit after:absolute after:inset-0 after:bg-lime-green/37">
      <Image
        src={aboutImg}
        alt="Group of people cooking"
        layout="constrained"
        priority
        quality={75}
        class="aspect-3/2"
      />
    </div>
    <p class="about__text clamp-[text,1rem,1.15rem]">
      Thivi Edu brings culinary practice and hospitality learning together. Our
      programs explore the skills behind a considered guest experience:
      preparing and serving food, coordinating day-to-day operations, guiding a
      team, and communicating with guests online. Whether you are drawn to the
      energy of a kitchen, the detail of event service, or the creativity of
      digital promotion, you can explore a pathway that connects your interests
      with the wider hospitality industry.
    </p>
  </section>
</Layout>

<style>
  .about {
    display: grid;
    grid-template-areas: "title" "image" "text";
    gap: 2rem;
  }

  .about__title {
    grid-area: title;
  }

  .about__text {
    grid-area: text;
  }

  .about__image {
    grid-area: image;
  }

  @media (width >= 64rem) {
    .about {
      grid-template-areas: "title title" "text image";
    }

    .about__image {
      height: fit-content;
    }
  }
</style>
