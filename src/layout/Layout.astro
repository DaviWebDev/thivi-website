---
import { SEO } from "astro-seo";
import { Font } from "astro:assets";
import "../styles/global.css";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import siteMetaData from "../constants/siteMetaData.json";

interface Props {
  seo: typeof siteMetaData.default;
  class?: string;
}

const { seo, class: mainClass } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/favicon/favicon.ico" />
    <link
      rel="icon"
      type="image/png"
      sizes="512x512"
      href="/favicon/android-chrome-512x512.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="192x192"
      href="/favicon/android-chrome-192x192.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/favicon/favicon-32x32.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="/favicon/favicon-16x16.png"
    />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/favicon/apple-touch-icon.png"
    />
    <link rel="manifest" href="/favicon/site.webmanifest" />
    <SEO
      title={seo?.title ?? siteMetaData.default.title}
      description={seo?.description ?? siteMetaData.default.description}
    />
    <slot name="preload" />
    <Font cssVariable="--poppins" preload />
    <Font cssVariable="--averta-demo-pe" preload />
  </head>
  <body>
    <div class="relative bg-lime-green flex justify-center text-white w-full h-12 z-101">
      <div class="max-w-300 h-full flex justify-center items-center flex-1 md:justify-end md:pe-2">
        <address class="font-averta not-italic flex gap-3 text-end">
          <a href="tel:+9530123654896">
            <span>+953 012 3654 896</span>
          </a>
          <a href="mailto:support@thivi.com">
            <span>support@thivi.com</span>
          </a>
        </address>
      </div>
    </div>
    <Header />
    <main class:list={["main", mainClass]}>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  body {
    max-width: 2200px;
    margin: 0 auto;
  }
</style>
