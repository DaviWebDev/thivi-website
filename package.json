{
  "name": "thivi-website",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.22.1"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "docker:preview": "docker build --target prod -t thivi-prod . && docker run --rm -d --name thivi-prod -p 4322:80 thivi-prod",
    "docker:rebuild": "docker build --no-cache --target prod -t thivi-prod . && docker run --rm -d --name thivi-prod -p 4322:80 thivi-prod",
    "docker:stop-prod": "docker stop thivi-prod",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,md,mdx,astro}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,md,mdx,astro}\"",
    "lint": "eslint \"**/*.{ts,astro}\"",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.11",
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.1",
    "astro-icon": "^1.2.0",
    "astro-seo": "^1.2.0",
    "sharp": "^0.35.5",
    "tailwind-clamp": "^4.5.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript/native": "npm:typescript@^7",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.0"
  },
  "lint-staged": {
    "**/*.{ts,astro}": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*.{js,jsx,tsx,md,mdx,css,json}": "prettier --write"
  },
  "allowScripts": {
    "esbuild": true
  }
}
